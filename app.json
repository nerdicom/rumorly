{
  "expo": {
    "name": "Rumorly",
    "slug": "rumorly",
    "owner": "nerdicom",
    "extra": {
      "eas": {
        "projectId": "ac6cf278-9e81-448b-987a-b4bf117d6dea"
      }
    },
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rumorly.mobile"
    },
    "android": {
      "package": "app.rumorly.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#252135",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Rumorly"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5FA",
          "image": "./assets/icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#111118"
          }
        }
      ],
      "expo-system-ui"
    ],
    "scheme": "rumorly",
    "backgroundColor": "#F6F5FA"
  }
}
